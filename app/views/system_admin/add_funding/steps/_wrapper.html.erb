<%# Shared shell for every wizard step. locals: title, step. Yields the GOV.UK %>
<%# form builder so each step only supplies its own field(s). %>
<% wizard = Wizards::AddFundingWizard.new(step, editing: editing?, draft: draft) %>
<% previous_step = wizard.previous_step %>
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= render PageTitle::View.new(text: title, has_errors: @step_form.errors.present?) %>

    <%= govuk_back_link(
          href: previous_step ? funding_management_add_step_path(step: previous_step, from: (editing? ? "check" : nil)) :
                                 funding_management_requirements_path(academic_year: draft["academic_year"])) %>

    <span class="govuk-caption-l">Add funding</span>

    <%= register_form_with model: @step_form,
          url: funding_management_add_step_path(step:, from: (editing? ? "check" : nil)),
          method: :patch do |f| %>
      <%= f.govuk_error_summary %>
      <%= yield f %>
      <%= f.govuk_submit(editing? ? "Save and continue" : "Continue") %>
    <% end %>
  </div>
</div>
