<% page_title = t("components.page_titles.funding_schools.index") %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <%= render PageTitle::View.new(text: page_title) %>
    <h1 class="govuk-heading-l"><%= page_title %></h1>

    <%= render "system_admin/tab_nav" %>

    <p class="govuk-body">
      Schools recorded as disadvantaged or special schools for funding for the
      <%= @academic_cycle.label %> academic year.
    </p>

    <% if @designations.empty? %>
      <p class="govuk-body">No schools have been added for <%= @academic_cycle.label %>.</p>
    <% else %>
      <p class="govuk-body govuk-!-margin-bottom-2">
        <strong><%= @designations.size %></strong> <%= "school".pluralize(@designations.size) %>
      </p>

      <%= govuk_table do |table|
        table.with_head do |head|
          head.with_row do |row|
            row.with_cell(text: "URN")
            row.with_cell(text: "School")
            row.with_cell(text: "Town")
            row.with_cell(text: "Designation")
          end
        end

        table.with_body do |body|
          @designations.each do |designation|
            body.with_row do |row|
              row.with_cell(text: designation.school.urn)
              row.with_cell(text: designation.school.name)
              row.with_cell(text: designation.school.town)
              row.with_cell(text: govuk_tag(
                text: designation.designation_label,
                colour: designation.disadvantaged? ? "magenta" : "purple",
              ))
            end
          end
        end
      end %>
    <% end %>
  </div>
</div>
