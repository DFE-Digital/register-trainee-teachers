<% page_title = t("components.page_titles.relevant_degree_subjects.index") %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">
    <%= render PageTitle::View.new(text: page_title) %>

    <h1 class="govuk-heading-l"><%= page_title %></h1>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <%= render "system_admin/tab_nav" %>
    <%= render "system_admin/funding_nav" %>

    <% if @relevant_degree_subjects.empty? %>
      <p class="govuk-body">There are no relevant degrees.</p>
    <% else %>
      <%= govuk_table do |table|
        table.with_head do |head|
          head.with_row do |row|
            row.with_cell(text: "Academic year")
            row.with_cell(text: "ITT subject")
            row.with_cell(text: "Degree subject")
            row.with_cell(text: "HECoS code")
          end
        end
        table.with_body do |body|
          @relevant_degree_subjects.each do |relevant_degree_subject|
            body.with_row do |row|
              row.with_cell(text: relevant_degree_subject.academic_cycle.label)
              row.with_cell(text: relevant_degree_subject.allocation_subject.name)
              row.with_cell(text: relevant_degree_subject.degree_subject_name)
              row.with_cell(text: relevant_degree_subject.hecos_code)
            end
          end
        end
      end %>
    <% end %>
  </div>
</div>
