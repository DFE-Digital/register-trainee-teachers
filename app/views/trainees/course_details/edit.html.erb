<%= render PageTitle::View.new(text: ".heading", has_errors: @course_details_form.errors.present?) %>

<%= content_for(:breadcrumbs) do %>
  <%= render DynamicBackLink::View.new(@trainee, text: t(:back)) %>
<% end %>

<%= register_form_with(model: @course_details_form, url: trainee_course_details_path(@trainee), method: :put, local: true) do |f| %>
  <%= f.govuk_error_summary %>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <%= render TraineeName::View.new(@trainee) %>
      <h1 class="govuk-heading-l"><%= t(".heading") %></h1>

      <% if f.object.primary_phase? %>
        <%= render "primary_phase", f: f %>
      <% else %>
        <%= render "secondary_phase", f: f %>
      <% end %>

      <% if f.object.require_age_range? %>
        <%= f.govuk_radio_buttons_fieldset(:main_age_range,
                                           legend: { text: t(".age_range_label"), size: "s" },
                                           class: "age_range") do %>

          <% main_age_ranges_options(level: @course_details_form.course_education_phase).each_with_index do |age_range, index| %>
            <%= f.govuk_radio_button(:main_age_range, age_range,
                                     label: { text: age_range },
                                     link_errors: index.zero?) %>
          <% end %>

          <%= f.govuk_radio_divider %>

          <%= f.govuk_radio_button(:main_age_range,
                                   :other,
                                   label: { text: t(".other_age_range_label") }) do %>

            <%= f.govuk_collection_select(:additional_age_range,
                                          additional_age_ranges_options(level: @course_details_form.course_education_phase),
                                          :value,
                                          :text,
                                          label: { text: t(".additional_age_range_label") }) %>

          <% end %>
        <% end %>
      <% end %>

      <% if f.object.requires_study_mode? %>
        <%= f.govuk_radio_buttons_fieldset(:study_mode, legend: { text: t(".study_mode_label"), size: "s" }) do %>
          <%= f.govuk_radio_button :study_mode, COURSE_STUDY_MODES[:full_time], label: { text: t(".study_mode_full_time") }, link_errors: true %>
          <%= f.govuk_radio_button :study_mode, COURSE_STUDY_MODES[:part_time], label: { text: t(".study_mode_part_time") } %>
        <% end %>
      <% end %>

      <%= f.govuk_date_field(:itt_start_date,
                             date_of_birth: false,
                             legend: { text: t("publish_course_details.view.itt_start_date").html_safe, size: "s" },
                             hint: { text: t("activemodel.errors.models.course_details_form.attributes.itt_start_date.hint_html", year: Time.zone.now.year) }) %>

      <% end_date_hint = t("activemodel.errors.models.course_details_form.attributes.itt_end_date.hint_html", year: Time.zone.now.next_year.year) %>
      <% if @trainee.requires_level_five_declaration? && !@trainee.level_five_qualification.nil? %>
        <%# EYTDA: the Level 5 declaration sets the course length, so the end date can be filled in. %>
        <% end_date_hint += t("activemodel.errors.models.course_details_form.attributes.itt_end_date.level_five_hint_html", years: @trainee.level_five_course_years) %>
      <% end %>
      <%= f.govuk_date_field(:itt_end_date,
                            date_of_birth: false,
                            legend: { text: t("publish_course_details.view.itt_end_date").html_safe, size: "s" },
                            hint: { text: end_date_hint }) %>

      <% if @course_details_form.course_length_section? %>
        <%# EYTDA: a full-time course longer than the usual 2 or 3 years shows a warning and needs confirming. %>
        <%# The page script shows and hides it as the dates change. %>
        <% scope = "activemodel.errors.models.course_details_form.attributes.extended_course_confirmed" %>
        <% years = @trainee.level_five_course_years %>
        <% warning_key = "#{scope}.#{@trainee.level_five_qualification ? 'warning_level_five' : 'warning_no_level_five'}" %>
        <% longer = @course_details_form.course_longer_than_usual? %>
        <%= tag.div(hidden: !longer,
                    data: { module: "app-course-length",
                            usual_years: years,
                            latest_year: @course_details_form.latest_end_year,
                            full_time: @course_details_form.study_mode.to_s == COURSE_STUDY_MODES[:full_time],
                            warning: t(warning_key, years: years, length: "{length}") }) do %>
          <%= f.hidden_field(:course_length_warning_shown, value: longer ? "1" : "", data: { course_length_shown: true }) %>
          <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
              <span class="govuk-visually-hidden">Warning</span>
              <span data-course-length-text><%= t(warning_key, years: years, length: course_length_text(@course_details_form.itt_start_date, @course_details_form.itt_end_date)) if longer %></span>
            </strong>
          </div>
          <%= f.govuk_check_boxes_fieldset(:extended_course_confirmed,
                                           multiple: false,
                                           small: true,
                                           legend: { text: t("#{scope}.legend"), size: "s" }) do %>
            <%= f.govuk_check_box(:extended_course_confirmed, 1, 0,
                                  multiple: false,
                                  link_errors: true,
                                  checked: @course_details_form.extended_course_confirmed?,
                                  label: { text: t("#{scope}.label", years:) }) %>
          <% end %>
        <% end %>
      <% end %>

      <%= f.govuk_submit %>
    </div>
  </div>
<% end %>

<%= render(CancelLink::View.new(@trainee)) %>


