<%= render PageTitle::View.new(i18n_key: "trainees.level_five_declaration.edit", has_errors: @level_five_declaration_form.errors.present?) %>

<%= content_for(:breadcrumbs) do %>
  <%= render DynamicBackLink::View.new(@trainee, text: t(:back)) %>
<% end %>

<%= register_form_with(model: @level_five_declaration_form, url: trainee_level_five_declaration_path(@trainee), method: :put, local: true) do |f| %>
  <%= f.govuk_error_summary %>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <%= render TraineeName::View.new(@trainee) %>
      <h1 class="govuk-heading-l"><%= t(".heading") %></h1>

      <p class="govuk-body"><%= t(".duration_intro") %></p>
      <ul class="govuk-list govuk-list--bullet">
        <li><%= t(".with_level_five_html") %></li>
        <li><%= t(".without_level_five_html") %></li>
      </ul>
      <p class="govuk-body"><%= t(".examples") %></p>

      <% if @trainee.progress.course_details || @trainee.progress.funding %>
        <%= govuk_warning_text(text: t(".change_warning")) %>
      <% end %>

      <%= f.govuk_radio_buttons_fieldset(:level_five_qualification, legend: { text: t(".question"), size: "m" }) do %>
        <%= f.govuk_radio_button(:level_five_qualification, true, label: { text: t(".yes") }, hint: { text: t(".yes_hint") }, link_errors: true) %>
        <%= f.govuk_radio_button(:level_five_qualification, false, label: { text: t(".no") }, hint: { text: t(".no_hint") }) %>
      <% end %>

      <%= f.govuk_submit %>
    </div>
  </div>
<% end %>

<%= render(CancelLink::View.new(@trainee)) %>
