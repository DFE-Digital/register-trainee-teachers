<%= render PageTitle::View.new(text: t("components.page_titles.trainees.show.#{@trainee.apply_application? ? 'apply_draft' : 'draft'}"), has_errors: @trainee.errors.present? || @funding_prerequisites.present? || @course_prerequisites.present?) %>

<%= content_for(:breadcrumbs) do %>
  <%= render FilteredBackLink::View.new(
    href: trainees_path,
    text: t("views.draft_records"),
  ) %>
<% end %>

<% if @funding_prerequisites.present? || @course_prerequisites.present? %>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <%= render ErrorSummary::View.new(renderable: true) do %>
        <% @course_prerequisites.each do |prerequisite| %>
          <%= tag.li(govuk_link_to(t("views.forms.course_prerequisites.#{prerequisite}.summary"), edit_trainee_level_five_declaration_path(@trainee))) %>
        <% end %>
        <% @funding_prerequisites.each do |prerequisite| %>
          <%= tag.li(govuk_link_to(t("views.forms.funding.prerequisites.#{prerequisite}.summary"), funding_prerequisite_path(@trainee, prerequisite))) %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<%= render "recheck_banner", trainee: @trainee %>

<%= render ReviewDraft::View.new(trainee: @trainee, funding_prerequisites: @funding_prerequisites, course_prerequisites: @course_prerequisites) %>

<h2 class="govuk-heading-m">Final check</h2>
  <%= render GovukButtonLinkTo::View.new(body: "Check this record", url: trainee_check_details_path(@trainee), id: "check-details") %>
<p class="govuk-body"><%= govuk_link_to("Return to this draft later", drafts_path) %></p>

<p class="govuk-body govuk-!-margin-top-8">
  <%= govuk_link_to "Delete this draft", trainee_confirm_delete_path(@trainee), class: "app-link--warning" %>
</p>
