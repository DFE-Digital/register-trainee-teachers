<% page_text = {
  grant_and_tiered_bursary: "Funding",
  grant: "Grant funding",
  non_tiered_bursary: "Funding",
}[@funding_manager.applicable_available_funding] %>
<%= render PageTitle::View.new(text: page_text,
                               has_errors: @bursary_form.errors.present?) %>

<%= content_for(:breadcrumbs) do %>
  <%= render DynamicBackLink::View.new(@trainee, text: t(:back)) %>
<% end %>

<% if @funding_manager.using_draft_amounts? %>
  <%= render "trainees/funding/amount_not_signed_off_banner", academic_year: @funding_manager.funding_cycle.label, draft: true %>
<% end %>

<% if @funding_manager.early_years_salaried_grant? %>
  <%= render "early_years_salaried_grant_form" %>
<% else %>
  <%= render "#{@funding_manager.applicable_available_funding}_form" %>
<% end %>
