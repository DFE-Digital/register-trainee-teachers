<%= register_form_with(model: @bursary_form, url: trainee_funding_bursary_path(@trainee), method: :put, local: true) do |f| %>
  <%= f.govuk_error_summary %>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <%= render TraineeName::View.new(@trainee) %>
      <h1 class="govuk-heading-l"><%= t("components.page_titles.trainees.funding.grants.edit") %></h1>

      <% if @bursary_form.yearly_route? %>
        <p class="govuk-body">
          <%= t(
            "views.forms.funding.bursaries.grant.yearly_description",
            training_route: t("activerecord.attributes.trainee.training_routes.#{@trainee.training_route}"),
          ) %>
        </p>

        <% if @funding_manager.shortened_by_level_five? %>
          <p class="govuk-body">
            <%= t("views.forms.funding.bursaries.grant.level_five_years", years: @funding_manager.training_years, first_year: @funding_manager.funded_years.first, last_year: @funding_manager.funded_years.last) %>
          </p>
        <% end %>

        <h2 class="govuk-heading-m">
          <%= t("views.forms.funding.bursaries.grant.yearly_heading", academic_year: @trainee.start_academic_cycle.label) %>
        </h2>
        <% if @funding_manager.funding_carried_forward? %>
          <p class="govuk-body">
            <%= t("views.forms.funding.bursaries.grant.carried_forward", academic_year: @funding_manager.funding_cycle.label) %>
          </p>
        <% end %>
        <%= govuk_summary_list(actions: false) do |summary_list| %>
          <% @bursary_form.grant_amounts_by_year.each do |year, amount| %>
            <% summary_list.with_row do |row| %>
              <% row.with_key(text: @bursary_form.training_year_label(year)) %>
              <% row.with_value(text: format_currency(amount)) %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <p class="govuk-body">
          <%= t(
            (@trainee.early_years_route? ? "views.forms.funding.bursaries.grant.early_years_description" : "views.forms.funding.bursaries.grant.description"),
            amount: format_currency(@bursary_form.grant_amount),
            subject: @bursary_form.allocation_subject_name,
            training_route: t("activerecord.attributes.trainee.training_routes.#{@trainee.training_route}"),
          ) %>
        </p>
      <% end %>

      <%= render "explanations" %>

      <p class="govuk-body">
        <%= govuk_link_to(
          t("views.forms.funding.bursaries.guidance_link_text"),
          @bursary_form.funding_guidance_url,
          target: "_blank",
          rel: "noopener noreferrer",
        ) %> (opens in new tab).
      </p>

      <%= f.govuk_radio_buttons_fieldset(:funding_type, legend: { text: t("views.forms.funding.bursaries.grant.title"), size: "m" }) do %>
          <%= f.govuk_radio_button(
            :funding_type,
            FUNDING_TYPE_ENUMS[:grant],
            label: { text: @bursary_form.yearly_route? ? t("views.forms.funding.funding_type.grant.yearly_label") : t("views.forms.funding.funding_type.grant.label", amount: format_currency(@bursary_form.grant_amount)) },
            hint: { text: @bursary_form.yearly_route? ? t("views.forms.funding.funding_type.grant.yearly_hint", training_year: @bursary_form.training_year_label) : t("views.forms.funding.funding_type.grant.hint") },
            link_errors: true,
          ) %>

          <%= f.govuk_radio_button(
            :funding_type,
            f.object.class::NONE_TYPE,
            label: { text: t("views.forms.funding.funding_type.grant.none.label") },
          ) %>
      <% end %>

      <%= f.govuk_submit %>
    </div>
  </div>
<% end %>
